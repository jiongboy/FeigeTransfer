# Release artifacts and temporary downloads are stored beside Project, never tracked
/Release/
/download/

# Build caches and intermediate files
.build/
.swiftpm/
**/bin/
**/obj/
AppPackages/
.DerivedData/
DerivedData/

# macOS bundles are output only, but git ignores case, so *.app would also hide the Windows
# source directory src/Feige.App. Re-include traceable source files, then re-apply build output
# rules below so bin/obj caches still stay out of the repository.
*.app/
*.dmg
!Project/**
Project/**/bin/
Project/**/obj/
Project/**/.build/
Project/**/.swiftpm/
Project/**/.DS_Store

# macOS build outputs and local IDE state
**/.DS_Store
**/.xcuserstate
**/xcuserdata/
**/DerivedData/

# Windows local IDE state and packages
.vs/
/.signing/
.certs/
*.pfx
*.cer
Package.StoreAssociation.xml
*.msix
*.msixbundle
*.appx
*.appxbundle

# Local agent workspace data
.workbuddy/

# Legacy / generated release material accidentally retained in older trees
**/release/*.exe
**/release/*.zip
**/release/*.dmg
**/release/*.msix
