<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Feige.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="飞鸽快传">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid Background="{ThemeResource FeigeShellBrush}" SizeChanged="OnShellSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="飞鸽快传">
            <TitleBar.IconSource><ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.png" /></TitleBar.IconSource>
        </TitleBar>
        <StackPanel x:Name="GuidancePanel" Grid.Row="1" Spacing="6" Margin="12,0,12,6" Visibility="Collapsed">
            <InfoBar x:Name="PendingSetupBar" IsOpen="False" IsClosable="False" Severity="Warning" Title="连接尚未就绪" Message="可以查看记录和设置；继续准备后才能连接与收发。">
                <InfoBar.ActionButton><Button x:Name="ContinueSetupButton" Content="继续设置" Click="OnContinueSetupClick" /></InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="LegacyReviewBar" IsOpen="False" Title="原有资料已保留" Message="可在设置中核对设备名称、接收位置和使用偏好。" CloseButtonClick="OnLegacyReviewClose">
                <InfoBar.ActionButton><Button x:Name="ReviewSettingsButton" Content="核对设置" Click="OnReviewSettingsClick" /></InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="FirstConnectionBar" IsOpen="False" Title="已连接" Message="可以发送文字，或选择图片和文件。断开后再次连接需要对方同意。Enter 发送，Shift+Enter 换行。" CloseButtonClick="OnConnectionTipClose" />
            <InfoBar x:Name="FirstTransferBar" IsOpen="False" Severity="Success" Title="收发成功" Message="消息已由对方确认送达，或文件已完整保存。" CloseButtonClick="OnTransferTipClose" />
            <InfoBar x:Name="NotificationInvitationBar" IsOpen="False" Title="需要收发完成通知吗？" Message="启用后可收到系统提示；跳过也不影响收发。" CloseButtonClick="OnNotificationInvitationClose">
                <InfoBar.ActionButton><Button x:Name="EnableNotificationsButton" Content="启用通知" Click="OnEnableNotificationsClick" /></InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="BackgroundNoticeBar" IsOpen="False" Title="应用仍在后台运行" Message="关闭窗口后仍可在后台收发，从开始菜单重新打开；停止运行请在设置中退出应用。" CloseButtonClick="OnBackgroundNoticeClose" />
            <InfoBar x:Name="UpdateResultBar" IsOpen="False" Severity="Success" Title="更新完成" CloseButtonClick="OnUpdateResultClose" />
        </StackPanel>
        <InfoBar x:Name="UpdateAvailableBar" Grid.Row="2" Margin="12,0,12,6" IsOpen="False" Title="发现新版本" CloseButtonClick="OnUpdateLater">
            <InfoBar.ActionButton><Button x:Name="UpdateActionButton" Content="更新" Click="OnViewUpdateClick" /></InfoBar.ActionButton>
        </InfoBar>
        <NavigationView x:Name="NavView" Grid.Row="3"
            PaneDisplayMode="Left" OpenPaneLength="176" CompactPaneLength="64"
            IsPaneOpen="True" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
            IsPaneVisible="True" IsSettingsVisible="True" IsTabStop="False"
            PaneTitle="局域网互传" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <!-- The stock 40px icon column plus its tray margin left a wide gap between
                     glyph and label; a 20px box with a 6px tray margin closes it. -->
                <x:Double x:Key="NavigationViewItemOnLeftIconBoxWidth">20</x:Double>
                <x:Double x:Key="NavigationViewItemIconBoxWidth">20</x:Double>
                <Thickness x:Key="NavigationViewItemIconBoxMargin">6,0,6,0</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="MessagesNavItem" Content="消息" Tag="send" IsSelected="True" Margin="0,8,0,4" Height="44" ToolTipService.ToolTip="消息与设备会话">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="RecordsNavItem" Content="传输记录" Tag="receive" Margin="0,0,0,4" Height="44" ToolTipService.ToolTip="传输记录">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" Margin="0,0,10,10" Background="{ThemeResource FeigePanelBrush}" CornerRadius="12" />
        </NavigationView>
    </Grid>
</Window>
