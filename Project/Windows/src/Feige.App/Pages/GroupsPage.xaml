<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Feige.App.Pages.GroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource FeigePanelBrush}" Padding="20" SizeChanged="OnRootSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12" Margin="4,0,4,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="群组会话" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="通过已认证的群组安全连接（v4/v5）通信。群组邀请、文件接收与成员事务均需明确处理。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="CreateButton" Grid.Column="1" Content="新建群组" Click="OnCreateClick" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="280"/><ColumnDefinition x:Name="DetailColumn" Width="*"/></Grid.ColumnDefinitions>
            <ListView x:Name="GroupList" SelectionMode="Single" SelectionChanged="OnGroupSelected" IsItemClickEnabled="True" ItemClick="OnGroupItemClick" HorizontalContentAlignment="Stretch" BorderThickness="0"/>
            <Grid Grid.Column="1" x:Name="DetailPane" Padding="20,4,4,4">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="ConversationAndInspectorGrid" Grid.Row="0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ChatColumn" Width="*"/><ColumnDefinition x:Name="MemberInspectorColumn" Width="310"/></Grid.ColumnDefinitions>
                    <Grid x:Name="ChatPane" Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GroupTitle" Text="选择群组" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button x:Name="ShowGroupsButton" Grid.Column="1" Content="群组列表" Click="OnShowGroupsClick" Visibility="Collapsed"/>
                                    <Button x:Name="MembersButton" Grid.Column="2" Content="成员面板" Click="OnMembersClick" Visibility="Collapsed"/>
                                </Grid>
                                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False"/>
                                <StackPanel x:Name="OperationPanel" Spacing="5"/>
                                <Button x:Name="PickFileButton" Content="发送文件" Click="OnPickFileClick" IsEnabled="False" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                        <ListView x:Name="MessageList" Grid.Row="1" SelectionMode="None" BorderThickness="0" Margin="0,12,0,12"/>
                    </Grid>
                    <Border x:Name="MemberInspector" Grid.Column="1" Padding="14" CornerRadius="12" Background="{ThemeResource FeigePanelBrush}">
                        <StackPanel Spacing="9">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="群聊成员" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MemberGroupName" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MemberCount" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="CloseMemberInspectorButton" Content="返回群聊" Click="OnCloseMemberInspectorClick" Visibility="Collapsed"/>
                                    <Button x:Name="LeaveButton" Content="申请退出群聊" Click="OnLeaveClick" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="MemberSearch" PlaceholderText="搜索成员" TextChanged="OnMemberSearchChanged" AutomationProperties.Name="搜索群组成员"/>
                            <TextBlock x:Name="MemberConstraint" Text="成员名单变更需要所有现有成员在线并明确确认；群聊最多 20 人（含本机）。" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                                <StackPanel x:Name="MemberPanel" Spacing="7"/>
                            </ScrollViewer>
                            <Button x:Name="AddMemberButton" Content="添加成员" Click="OnAddMemberClick" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid x:Name="ComposerGrid" Grid.Row="1" ColumnSpacing="8" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="Composer" PlaceholderText="输入群消息" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"/>
                    <Button x:Name="SendButton" Grid.Column="1" Content="发送" Click="OnSendClick" Style="{StaticResource AccentButtonStyle}"/>
                </Grid>
            </Grid>
            <TextBlock x:Name="EmptyGroups" Grid.Column="1" Text="创建群组或选择已有群组。新建群组需要先与成员建立 v4/v5 连接；成员变更和文件接收都需要对方明确确认。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Page>
