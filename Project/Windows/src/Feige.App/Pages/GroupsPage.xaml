<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Feige.App.Pages.GroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource FeigePanelBrush}" Padding="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12" Margin="4,0,4,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="群组会话" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="通过已认证的群组安全连接（v4/v5）通信。群组邀请、文件接收与成员事务均需明确处理。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="CreateButton" Grid.Column="1" Content="新建群组" Click="OnCreateClick" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListView x:Name="GroupList" SelectionMode="Single" SelectionChanged="OnGroupSelected" HorizontalContentAlignment="Stretch" BorderThickness="0"/>
            <Grid Grid.Column="1" x:Name="DetailPane" Padding="20,4,4,4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="GroupTitle" Text="选择群组" FontSize="19" FontWeight="SemiBold"/>
                        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False"/>
                        <StackPanel x:Name="OperationPanel" Spacing="5"/>
                        <StackPanel x:Name="MemberPanel" Spacing="5"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="EditMembersButton" Content="移除成员" Click="OnEditMembersClick" IsEnabled="False"/>
                            <Button x:Name="LeaveButton" Content="离开并移交群主" Click="OnLeaveClick" IsEnabled="False"/>
                            <Button x:Name="PickFileButton" Content="发送文件" Click="OnPickFileClick" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ListView x:Name="MessageList" Grid.Row="2" SelectionMode="None" BorderThickness="0" Margin="0,12,0,12"/>
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="Composer" PlaceholderText="输入群消息" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"/>
                    <Button x:Name="SendButton" Grid.Column="1" Content="发送" Click="OnSendClick" Style="{StaticResource AccentButtonStyle}"/>
                </Grid>
            </Grid>
            <TextBlock x:Name="EmptyGroups" Grid.Column="1" Text="创建群组或选择已有群组。新建群组需要先与成员建立 v4/v5 连接；成员变更和文件接收都需要对方明确确认。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Page>
