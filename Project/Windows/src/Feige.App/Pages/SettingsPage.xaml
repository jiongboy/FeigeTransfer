<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Feige.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Feige.App.Services">
    <ScrollViewer x:Name="SettingsScroller" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="{Binding ViewportWidth, ElementName=SettingsScroller}" Padding="28" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="6" Margin="0,0,0,8">
                <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="管理本机设备、接收位置和使用偏好。" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Style="{StaticResource FeigeSectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="设备名称" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="其他设备会通过这个名称找到你。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="DeviceNameBox" PlaceholderText="输入设备名称" MaxLength="48" />
                        <Button x:Name="SaveDeviceNameButton" Grid.Column="1" Click="OnSaveNameClick" Content="保存" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <InfoBar x:Name="NameBar" IsClosable="True" IsOpen="False" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FeigeSectionCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="本机头像" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="头像只用于显示。你选择的预置头像 ID 会随局域网发现信息发送，不参与身份验证或权限判断。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <GridView x:Name="AvatarPicker" SelectionMode="Single" SelectionChanged="OnAvatarSelectionChanged" AutomationProperties.Name="选择本机头像">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="76" ItemHeight="72" /></ItemsPanelTemplate></GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="svc:AvatarChoice">
                                <StackPanel Width="72" Height="68" Spacing="3" HorizontalAlignment="Center">
                                    <Image Source="{x:Bind Image}" Width="40" Height="40" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <InfoBar x:Name="AvatarBar" IsClosable="True" IsOpen="False" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FeigeSectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="本机连接信息" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionStatusText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="LocalAddressText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="与对方处于同一局域网，连接请求需对方同意。手动连接时，可将以上地址和端口提供给对方。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FeigeSectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="接收文件夹" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="FolderText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Button Click="OnChangeFolderClick" Content="更改文件夹" />
                    <InfoBar x:Name="FolderBar" IsOpen="False" Severity="Error" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FeigeSectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="版本与更新" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentVersionText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CheckUpdatesButton" Content="检查更新" Click="OnCheckUpdatesClick" />
                        <ProgressRing x:Name="CheckUpdatesProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="正在检查更新" />
                    </StackPanel>
                    <TextBlock Text="查看连接步骤和 Windows 防火墙指引，不会重置设备身份或记录。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="UsageHelpButton" Content="使用帮助" Click="OnUsageHelpClick" />
                    <ToggleSwitch x:Name="AutoUpdatesSwitch" Header="自动检查更新" OnContent="开启" OffContent="关闭" Toggled="OnAutoUpdatesToggled" />
                    <TextBlock Text="初始化完成后，每 24 小时最多联网检查一次；失败不影响局域网收发。下载和安装分别确认，更新来源未配置时不会请求网络。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="UpdateReleaseText" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                    <ProgressBar x:Name="UpdateDownloadProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <TextBlock x:Name="UpdateDownloadText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DownloadUpdateButton" Content="下载更新" Click="OnDownloadUpdateClick" Visibility="Collapsed" />
                        <Button x:Name="InstallUpdateButton" Content="安装并重启" Click="OnInstallUpdateClick" Visibility="Collapsed" />
                        <Button x:Name="SkipUpdateButton" Content="跳过此版本" Click="OnSkipUpdateClick" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="UpdateNotesButton" Content="查看完整更新说明" Click="OnUpdateNotesClick" Visibility="Collapsed" />
                        <Button x:Name="CancelUpdateButton" Content="取消" Click="OnCancelUpdateClick" Visibility="Collapsed" />
                    </StackPanel>
                    <InfoBar x:Name="UpdatesPreferenceBar" IsOpen="False" Severity="Error" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FeigeSectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="通知（可选）" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="NotifyStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button x:Name="EnableNotifyButton" Click="OnEnableNotifyClick" Content="启用通知" />
                    <Button x:Name="TestNotifyButton" Click="OnTestNotifyClick" Content="发送测试通知" />
                    <InfoBar x:Name="NotifyBar" IsClosable="True" IsOpen="False" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FeigeSectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="本机记录" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="HistoryText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ClearHistoryButton" Click="OnClearHistoryClick" Content="清空记录" />
                        <Button Click="OnOpenAppDataClick" Content="打开数据目录" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FeigeSectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="隐藏的会话" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="隐藏仅从会话列表移除，聊天记录仍保留；收到新消息或重新连接时会再次显示。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="HiddenConversationsEmpty" Text="没有隐藏的会话。" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <ListView x:Name="HiddenConversationList" MaxHeight="240" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="隐藏的会话">
                        <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0,5" /></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:ConversationItem">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button x:Name="RestoreHiddenConversationButton" Grid.Column="1" Content="恢复" Click="OnRestoreConversationClick" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="RestoreAllConversationsButton" Content="全部恢复" Click="OnRestoreAllConversationsClick" />
                    <InfoBar x:Name="HiddenConversationsBar" IsOpen="False" Severity="Error" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FeigeSectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="其他网段" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="对方在其他网段时自动发现不可用，可在此保存对方地址或网段，例如 192.168.60.12、192.168.60（整个网段）或 192.168.60.0/24。一行一项，最多 16 项。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="ProbeTargetsBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="72" FontFamily="Consolas" AutomationProperties.Name="其他网段，一行一项" />
                    <ToggleSwitch x:Name="AllowsProbesSwitch" Header="允许其他网段发现本机" OnContent="开启" OffContent="关闭" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveProbeTargetsButton" Content="保存网段" Click="OnSaveProbeTargetsClick" />
                        <DropDownButton Content="添加常用网段" AutomationProperties.Name="添加常用网段">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="CommonProbeTargetsFlyout" Placement="Bottom" Opening="OnCommonProbeTargetsOpening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    <TextBlock x:Name="ProbeHintText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <InfoBar x:Name="ProbeTargetsBar" IsOpen="False" Severity="Error" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FeigeSectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="常驻联系人" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="常驻联系人上线后自动连接，对方发起的连接自动同意；接收文件仍需确认。只认设备身份，不看名称或地址。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TrustedPeersEmpty" Text="没有常驻联系人。可以在连接确认框或会话右键菜单中设置。" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    <StackPanel x:Name="TrustedPeersPanel" Spacing="8" AutomationProperties.Name="常驻联系人" />
                </StackPanel>
            </Border>
            <Expander HorizontalAlignment="Stretch" Header="设备身份与连接安全">
                <StackPanel Spacing="10">
                    <TextBlock Text="设备身份保存在本机，用于识别连接设备；私钥不会发送给其他设备。下方指纹可用于核对身份。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="FingerprintText" FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
            <Border Style="{StaticResource FeigeSectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="应用运行" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="关闭窗口后仍在后台运行，可从开始菜单重开。退出应用会断开当前连接并结束收发。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button x:Name="ExitAppButton" Click="OnExitAppClick" AutomationProperties.Name="退出应用">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                            <TextBlock Text="退出应用" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <StackPanel Spacing="5" Margin="0,4,0,12">
                <TextBlock Text="飞鸽快传 for Windows" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="同意一次连接，轻松互传文字、图片和文件。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="© Songli" FontSize="12" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
